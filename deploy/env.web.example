# Runtime config for the public site (apps/web).
# Copy to .env.web on VPS A: cp env.web.example .env.web && chmod 600 .env.web

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Internal API origin over the shared Docker network. Used by server components,
# route handlers, and the sitemap.
RACETIFY_API_INTERNAL_URL=http://api:8080

# Server-side origin for API CSRF checks and absolute URLs.
NEXT_PUBLIC_SITE_URL=https://racetify.com

# Optional; only needed if it is not the default.
# RACETIFY_SESSION_COOKIE_NAME=__Host-racetify_session

# NOTE: RACETIFY_API_ORIGIN is a Docker build arg and is baked into the
# next.config rewrite at build time. Changing it here has no effect.
