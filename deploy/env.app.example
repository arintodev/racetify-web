# Runtime config for the organizer app (apps/app).
# Copy to .env.app on VPS A: cp env.app.example .env.app && chmod 600 .env.app

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Internal API origin over the shared Docker network.
RACETIFY_API_INTERNAL_URL=http://api:8080

# The app origin is the CSRF Origin sent by server components and the OAuth
# callback origin. Must exactly match an entry in the API's PUBLIC_ORIGINS.
NEXT_PUBLIC_SITE_URL=https://app.racetify.com

# Must match the API's session cookie name.
RACETIFY_SESSION_COOKIE_NAME=__Host-racetify_session

# NOTE: RACETIFY_API_ORIGIN is a Docker build arg and is baked into the
# next.config rewrite at build time. Changing it here has no effect.
