{
  "name": "racetify-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "contract:sync": "pnpm --filter @workspace/api-contract sync",
    "contract:generate": "pnpm --filter @workspace/api-contract generate",
    "contract:check": "pnpm contract:sync && pnpm contract:generate && git diff --exit-code packages/api-contract/openapi.yaml packages/api-client/src/generated/schema.d.ts"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
